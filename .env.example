# ---------------------------------------------------------------
# Supabase connection (optional for local development)
# ---------------------------------------------------------------
# Copy this file to `.env` and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
#
# Without these values the app still works: progress and code
# snippets are saved to localStorage instead of the cloud.
# ---------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
