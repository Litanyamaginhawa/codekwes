{
  // Cloudflare Workers deployment config (static assets).
  // SPA deep links (e.g. /practice, /playground/...) fall back to index.html
  // via not_found_handling - this replaces the Pages-style public/_redirects
  // rule that Workers rejects with error code 100324.
  "name": "codekwes",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
