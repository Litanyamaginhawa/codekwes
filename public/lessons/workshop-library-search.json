xtContent = result;\n  } catch (err) {\n    statusDisplay.textContent = err.message;\n    console.error(err);\n    debugger;\n  } finally {\n    bookInput.value = \"\";\n  }\n});\n</script>","seedLang":"html","region":[54,75],"solution":null,"solutionLang":null,"beforeAll":"","beforeEach":""},{"kind":"challenge","id":"6a1d3032bdcd0ab7f47a251c","title":"Step 11","challengeType":0,"demoType":null,"description":"Now it is time to put your new element to work!\n\nInside your `finally` block, right underneath where you clear the input, set the `textContent` of your `scanStatusDisplay` variable to exactly `\"Library scan finished.\"`.\n\nTry running a few successful and failed searches in the preview, and observe how the UI responds. Congratulations on completing your Library Book Search!","hints":[{"text":"You should set `scanStatusDisplay.textContent` to `\"Library scan finished.\"` inside your `finally` block.","test":"document.getElementById('bookTitleInput').value = \"The Hobbit\";\ndocument.getElementById('search').click();\nassert.strictEqual(document.getElementById('scanStatus').textContent, \"Library scan finished.\");\n\ndocument.getElementById('scanStatus').textContent = \"\";\ndocument.getElementById('bookTitleInput').value = \"Test Search\";\ndocument.getElementById('search').click();\nassert.strictEqual(document.getElementById('scanStatus').textContent, \"Library scan finished.\");"}],"seed":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Library Book Search</title>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n  </head>\n  <body>\n    <div>\n      <h1>Find book title</h1>\n      <input type=\"text\" id=\"bookTitleInput\" placeholder=\"Enter book title\">\n      <button id=\"search\">Search</button>\n      <p id=\"statusMessage\"></p>\n      <p id=\"scanStatus\"></p>\n    </div>\n    <script src=\"script.js\"></script>\n  </bod